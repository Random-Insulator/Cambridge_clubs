{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/server.js"
    },
    {
      "source": "/portal",
      "destination": "/backend/portal/login.html"
    },
    {
      "source": "/portal/",
      "destination": "/backend/portal/login.html"
    },
    {
      "source": "/portal/(.*)",
      "destination": "/backend/portal/$1"
    },
    {
      "source": "/admin",
      "destination": "/backend/portal/admin.html"
    },
    {
      "source": "/login",
      "destination": "/backend/portal/login.html"
    }
  ]
}
